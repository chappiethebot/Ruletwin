# Copy to .env.local and fill in. .env.local is git-ignored. Never commit real values.

# Anthropic API key for the rule extractor (console.anthropic.com -> API keys).
# Used only by `npm run extract` (CLI). The website never calls the model.
ANTHROPIC_API_KEY=

# Optional: path to the unzipped starter pack (defaults to the folder name from the event Drive).
# STARTER_DIR=C:\path\to\participant-final-no-hour16 3

